# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Secrets / API keys ---
.env
*.key
secrets.json
config.local.*

# --- Large / raw data (keep dir structure via .gitkeep, ignore contents) ---
data/raw/osm/*
data/raw/google_api/*
data/raw/tomtom/*
!data/**/.gitkeep
# ...but DO version the small collected flow-summary CSVs (the observed dataset).
!data/raw/tomtom/collected/
data/raw/tomtom/collected/*
!data/raw/tomtom/collected/*.csv

# --- Generated network binaries (reproducible via src/network/build_network.py) ---
*.graphml
*.gpkg

# --- SQLite reading store (binary; reproducible via `python -m src.data.store --backfill`) ---
*.db
*.sqlite
*.sqlite3

# --- osmnx / tooling caches ---
cache/
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db

# --- Jupyter ---
*.ipynb_checkpoints
