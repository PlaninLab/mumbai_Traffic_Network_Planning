# Copy this file to `.env` and fill in your keys. `.env` is git-ignored — never commit real keys.

# Google Maps Platform (Routes API + Distance Matrix API)
# https://console.cloud.google.com/ → enable Routes API, create an API key
GOOGLE_MAPS_API_KEY=

# TomTom Traffic Flow API (optional, supplementary segment speeds)
# https://developer.tomtom.com/ → free tier: 2,500 requests/day
TOMTOM_API_KEY=
