# Copy this file to `.env` and fill in your keys. `.env` is git-ignored — never commit real keys.

# TomTom API key — flow source (Flow Segment, Routing, Matrix Routing).
# https://developer.tomtom.com/ → sign up with email (no credit card) → free tier 2,500 req/day
TOMTOM_API_KEY=

# HERE API key — high-quality segment flow (Traffic API v7: speed + free-flow + jam factor).
# https://platform.here.com → create a project → generate a REST API key.
# Used by:  python -m src.data.collect_flow --provider here
HERE_API_KEY=

# Google Maps Platform key — traffic-aware OD travel-time matrices (Routes API).
# Requires a billing-enabled Google Cloud project with the Routes API enabled (README §7.7).
# Used by:  build_od(cost_source="google")  /  python -m src.data.google_client matrix ...
GOOGLE_MAPS_API_KEY=
