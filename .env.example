# Copy this file to `.env` and fill in your keys. `.env` is git-ignored — never commit real keys.

# TomTom API key — PRIMARY traffic data source (Flow Segment, Routing, Matrix Routing).
# https://developer.tomtom.com/ → sign up with email (no credit card) → free tier 2,500 req/day
TOMTOM_API_KEY=

# Google Maps Platform — FALLBACK ONLY (requires a billing account with credit card).
# Leave blank unless TomTom coverage proves insufficient for specific segments (plan §3.2).
GOOGLE_MAPS_API_KEY=
